<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.cuckooy.ocpp</groupId>
    <artifactId>ocpp-project</artifactId>
    <packaging>pom</packaging>
    <version>${revision}</version>

    <name>OCPP Library Project</name>
    <description>OCPP Library Project</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <url>https://gitee.com/yuerzm/ocpp-project</url>
        <connection>scm:git:https://gitee.com/yuerzm/ocpp-project.git</connection>
        <developerConnection>scm:git:https://gitee.com/yuerzm/ocpp-project.git</developerConnection>
    </scm>

    <properties>
        <revision>1.0.0</revision>

        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <modules>
        <module>ocpp-dependencies</module>
        <module>ocpp-parent</module>
        <module>ocpp-bom</module>

        <module>ocpp-core</module>
        <module>ocpp-json</module>
        <module>ocpp-server</module>

        <module>ocpp-v16-core</module>
        <module>ocpp-v16-json</module>
        <module>ocpp-v16-api</module>
        <module>ocpp-v16-server</module>

        <module>ocpp-v20-core</module>
        <module>ocpp-v20-json</module>
        <module>ocpp-v20-server</module>
        <module>ocpp-v20-api</module>

        <module>ocpp-v21-core</module>

    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <configuration>
                    <tagBase>${project.version}</tagBase>
                    <tagNameFormat>@{project.version}</tagNameFormat>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <updateWorkingCopyVersions>true</updateWorkingCopyVersions>
                    <updateDependencies>true</updateDependencies>
                    <useReleaseProfile>true</useReleaseProfile>
                    <releaseProfiles>prod</releaseProfiles>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
